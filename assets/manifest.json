  "conventions": {
    "orientation": "rot 0 = sever hore; vozidlá a lode predkom hore; kotvisko s vodou na severe",
    "pivot": "ľavý horný roh footprintu, ak nie je uvedené inak (parts.*.pivot v px v rámci súboru)",
    "footprint": "w×h v bunkách pri rot 0; entity: w = šírka, h = dĺžka (SVG = w*64 × h*64)",
    "rotation": "engine rotuje po 90° okolo stredu footprintu; sprity sú kreslené v jednej orientácii",
    "waterTiles": "prípona = strana/roh s vodou; edge hĺbka vody 24 px",
    "shadow": "2 px dole-vpravo, 20 % — zapečené v SVG entít, žeriavov a závory",
    "connectors": "{x,y} = bunka vo footprinte pri rot 0, side = strana vjazdu, type = road|rail|pipe",
    "fileNames": "{id}[_{variant}][_{state}].svg"
  },
