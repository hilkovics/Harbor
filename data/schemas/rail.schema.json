{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rail.json",
  "description": "Železnica (R6, ADR-043): cestovný poriadok vlakov a vlak. Konfiguračný def bez items[] (ADR-009).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "timetable", "train"],
  "properties": {
    "schemaVersion": { "const": 1, "description": "Verzia schémy defu." },
    "timetable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalHours", "firstArrivalHour", "wagonsPerTrain", "dwellMinutes"],
      "properties": {
        "intervalHours": { "type": "number", "exclusiveMinimum": 0, "description": "Interval medzi plánovanými príchodmi vlakov v herných hodinách." },
        "firstArrivalHour": { "type": "integer", "minimum": 0, "description": "Hodina hry (od ticku 0) prvého plánovaného príchodu." },
        "wagonsPerTrain": { "type": "integer", "minimum": 1, "description": "Počet vagónov vlaku okrem lokomotívy." },
        "dwellMinutes": { "type": "integer", "minimum": 1, "description": "Plánovaný pobyt vlaku v termináli v herných minútach od zastavenia; vlak odíde skôr, keď je plný." }
      }
    },
    "train": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speedMilliCellsPerTick", "locoLengthCells", "wagonLengthCells", "wagonTeu"],
      "properties": {
        "speedMilliCellsPerTick": { "type": "integer", "minimum": 1, "description": "Rýchlosť vlaku v tisícinách bunky za tick (1000 = bunka za tick)." },
        "locoLengthCells": { "type": "integer", "minimum": 1, "description": "Dĺžka lokomotívy v bunkách (bunka = 6 m)." },
        "wagonLengthCells": { "type": "integer", "minimum": 1, "description": "Dĺžka vagóna v bunkách (vagón 60′ = 3 bunky)." },
        "wagonTeu": { "type": "integer", "minimum": 1, "description": "Kapacita vagóna v TEU (wagon_container_60 = 3: 40′ + 20′ alebo 3× 20′)." }
      }
    }
  }
}
