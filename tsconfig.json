{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@sim/*": ["./src/sim/*"],
      "@render/*": ["./src/render/*"],
      "@ui/*": ["./src/ui/*"],
      "@app/*": ["./src/app/*"],
      "@data/*": ["./data/*"]
    }
  },
  "include": ["src", "tools", "tests", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", ".claude", "coverage", "test-results", "playwright-report", "blob-report"]
}
